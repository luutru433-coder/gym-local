{
  "name": "gym-local",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/performance-report.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:audit": "node scripts/verify-affected.mjs --architecture",
    "verify:affected": "node scripts/verify-affected.mjs",
    "verify": "pnpm run architecture:audit && pnpm run lint && pnpm run typecheck && pnpm run content:validate && pnpm run content:audit && pnpm run test && pnpm run build",
    "content:validate": "node scripts/content-validate.mjs",
    "content:audit": "node scripts/content-audit.mjs && node scripts/nutrition-content-validate.mjs",
    "media:health": "node scripts/media-health-report.mjs",
    "media:health:online": "node scripts/media-health-report.mjs --online",
    "performance:report": "node scripts/performance-report.mjs",
    "nutrition:recipes": "node scripts/generate-vietnamese-recipes.mjs",
    "nutrition:verify-pack": "python scripts/verify-nutrition-pack.py --db outputs/gym-local-nutrition-2026.08.sqlite3 --manifest public/nutrition-pack-manifest.json",
    "db:test-migrations": "vitest run packages/storage",
    "backup:test": "vitest run packages/backup",
    "release:check": "pnpm run verify && pnpm run media:health"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@zxing/browser": "0.2.1",
    "dexie": "4.4.4",
    "jszip": "3.10.1",
    "lucide-react": "1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.0.13",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
