{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@gym/contracts": ["packages/contracts/src/index.ts"],
      "@gym/catalog/custom": ["packages/catalog/src/custom-exercise.ts"],
      "@gym/catalog": ["packages/catalog/src/index.ts"],
      "@gym/workouts/plan": ["packages/workouts/src/adaptive-plan.ts"],
      "@gym/workouts/superset": ["packages/workouts/src/superset.ts"],
      "@gym/workouts/set-timer": ["packages/workouts/src/set-timer.ts"],
      "@gym/workouts": ["packages/workouts/src/index.ts"],
      "@gym/nutrition/trends": ["packages/nutrition/src/trends.ts"],
      "@gym/nutrition": ["packages/nutrition/src/index.ts"],
      "@gym/progress": ["packages/progress/src/index.ts"],
      "@gym/storage/device": ["packages/storage/src/device-preferences.ts"],
      "@gym/storage/custom-exercises": ["packages/storage/src/custom-exercises.ts"],
      "@gym/storage/exercise-images": ["packages/storage/src/exercise-images.ts"],
      "@gym/storage/history": ["packages/storage/src/history-edit.ts"],
      "@gym/storage": ["packages/storage/src/index.ts"],
      "@gym/backup": ["packages/backup/src/index.ts"],
      "@gym/media/online-gifs": ["packages/media/src/providers/exercisedb-free.ts"],
      "@gym/media/exercise-pack": ["packages/media/src/exercise-pack.ts"],
      "@gym/media": ["packages/media/src/index.ts"],
      "@gym/ui": ["packages/ui/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["apps", "packages", "tests"]
}
